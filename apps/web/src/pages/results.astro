---
import Layout from '../layouts/Layout.astro';
import SavingsComparison from '../components/dashboard/SavingsComparison.svelte';
import OptimalCardMap from '../components/dashboard/OptimalCardMap.svelte';
import VisibilityToggle from '../components/ui/VisibilityToggle.svelte';
import AnalysisWarnings from '../components/ui/AnalysisWarnings.svelte';
import CapDisclosures from '../components/ui/CapDisclosures.svelte';
import { buildPageUrl } from '../lib/formatters.js';

const homeUrl = buildPageUrl('');
const dashboardUrl = buildPageUrl('dashboard');
const reportUrl = buildPageUrl('report');
---

<Layout title="추천 결과">
  <!-- Back link -->
  <div class="mb-6 print:hidden" data-print-control>
    <a
      href={homeUrl}
      class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-primary-fg)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
      </svg>
      명세서 업로드로 돌아가기
    </a>
  </div>

  <!-- Page header -->
  <div class="mb-8 animate-[slideUp_0.4s_ease_both]">
    <h1 class="text-3xl font-extrabold tracking-tight">카드 추천 결과</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">연회비 차감 전 월간 총혜택과 카드 조합을 보여줘요</p>
    <p id="results-status" class="sr-only" role="status" aria-live="polite">분석 결과를 확인하는 중이에요</p>
  </div>

  <!-- Stable readiness shell while persisted analysis is restored -->
  <div
    id="results-loading-state"
    class="flex min-h-64 flex-col items-center justify-center gap-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-8 py-16 text-center"
    aria-busy="true"
  >
    <span class="h-8 w-8 animate-spin rounded-full border-2 border-[var(--color-border)] border-t-[var(--color-primary-fg)]" aria-hidden="true"></span>
    <p class="text-sm font-medium text-[var(--color-text-muted)]">저장된 추천 결과를 확인하고 있어요</p>
  </div>

  <!-- Error state when persisted or current analysis cannot be read -->
  <div
    id="results-error-state"
    class="hidden flex min-h-64 flex-col items-center justify-center gap-4 rounded-2xl border border-[var(--color-danger-fg)]/30 bg-[var(--color-surface)] px-8 py-16 text-center"
    role="alert"
  >
    <p class="text-base font-semibold text-[var(--color-danger-fg)]">추천 결과를 불러오지 못했어요</p>
    <p class="max-w-lg text-sm text-[var(--color-text-muted)]" data-analysis-error-message>분석 결과를 표시하지 못했어요.</p>
    <a
      href={homeUrl}
      class="mt-2 inline-flex items-center rounded-xl bg-[var(--color-primary-fill)] px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-[var(--color-primary-fill-hover)]"
    >
      명세서 다시 올리기
    </a>
  </div>

  <!-- Empty state when no data -->
  <div id="results-empty-state" class="hidden flex flex-col items-center gap-4 rounded-2xl border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] px-8 py-16 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="48" height="48" class="text-[var(--color-text-muted)] opacity-40" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
    </svg>
    <p class="text-base font-medium text-[var(--color-text-muted)]">아직 분석 결과가 없어요</p>
    <p class="text-sm text-[var(--color-text-muted)]">명세서를 올리면 최적 카드 조합을 알려줘요</p>
    <a
      href={homeUrl}
      class="mt-2 inline-flex items-center gap-1.5 rounded-xl bg-[var(--color-primary-fill)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--color-primary-fill-hover)] transition-colors"
    >
      명세서 올리러 가기
    </a>
  </div>

  <!-- Data-driven content (hidden until VisibilityToggle shows it) -->
  <div id="results-data-content" class="hidden">
    <AnalysisWarnings client:load />
    <CapDisclosures client:load />
    <!-- Summary statistics -->
    <div
      class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3 animate-[slideUp_0.4s_0.05s_ease_both]"
      style="opacity:0;animation-fill-mode:forwards;"
    >
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-center shadow-[var(--shadow-card)]">
      <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]">최근 월 지출</p>
      <p class="mt-2 text-2xl font-bold text-[var(--color-text)]" id="stat-total-spending">—</p>
    </div>
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-center shadow-[var(--shadow-card)]">
      <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]" id="stat-savings-label">단일 카드 대비 월간 추가 혜택 (연회비 차감 전)</p>
      <p class="mt-2 text-2xl font-bold text-[var(--color-success-fg)]" id="stat-total-savings">—</p>
    </div>
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 text-center shadow-[var(--shadow-card)]">
      <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]">필요한 카드</p>
      <p class="mt-2 text-2xl font-bold text-[var(--color-primary-fg)]" id="stat-cards-needed">—</p>
    </div>
  </div>

  <!-- Savings comparison component -->
  <div
    class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 shadow-[var(--shadow-card)] sm:p-6 animate-[slideUp_0.4s_0.1s_ease_both]"
    style="opacity:0;animation-fill-mode:forwards;"
  >
    <h2 class="mb-4 text-lg font-bold">연회비 차감 전 월간 총혜택 비교</h2>
    <SavingsComparison client:load />
  </div>

  <!-- OptimalCardMap component -->
  <div
    class="mt-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 shadow-[var(--shadow-card)] sm:p-6 animate-[slideUp_0.4s_0.15s_ease_both]"
    style="opacity:0;animation-fill-mode:forwards;"
  >
    <h2 class="mb-4 text-lg font-bold">항목별 추천 카드</h2>
    <OptimalCardMap client:load />
  </div>

  <!-- Action buttons -->
  <div
    class="mt-8 flex flex-wrap gap-4 print:hidden animate-[slideUp_0.4s_0.15s_ease_both]"
    style="opacity:0;animation-fill-mode:forwards;"
    data-print-control
  >
    <a
      href={reportUrl}
      class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-fill)] px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[var(--color-primary-fill-hover)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
      </svg>
      리포트 보기
    </a>
    <button
      id="download-report"
      type="button"
      data-print-trigger
      data-print-control
      class="inline-flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-3 text-sm font-semibold text-[var(--color-text)] shadow-sm transition-colors hover:border-[var(--color-focus)] hover:text-[var(--color-primary-fg)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m0 0a48.103 48.103 0 0 1 10.5 0m-10.5 0V6.312c0-.777.529-1.462 1.296-1.565A48.566 48.566 0 0 1 12 4.558c1.646 0 3.278.119 4.874.35.767.103 1.296.788 1.296 1.565V7.034"/>
      </svg>
      인쇄 / PDF 저장
    </button>
    <a
      href={homeUrl}
      class="inline-flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-3 text-sm font-semibold text-[var(--color-text-muted)] shadow-sm transition-colors hover:text-[var(--color-primary-fg)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182"/>
      </svg>
      다시 분석하기
    </a>
    <a
      href={dashboardUrl}
      class="inline-flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-3 text-sm font-semibold text-[var(--color-text-muted)] shadow-sm transition-colors hover:text-[var(--color-primary-fg)]"
    >
      분석 자세히 보기
    </a>
  </div>
  </div>

  <VisibilityToggle
    client:load
    dataContentId="results-data-content"
    emptyStateId="results-empty-state"
    loadingStateId="results-loading-state"
    errorStateId="results-error-state"
    statusTextId="results-status"
  />
</Layout>
