{
  "name": "cherrypicker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "turbo run build",
    "test": "turbo run test && bun test scripts/__tests__",
    "test:bun": "bun test packages/parser tools/scraper",
    "test:e2e": "bun scripts/run-e2e.ts regression",
    "test:e2e:screenshots": "bun scripts/run-e2e.ts screenshots",
    "e2e:status": "bun scripts/run-e2e.ts status",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "data:build": "bun scripts/build-json.ts && bun run docs:build",
    "data:check": "bun scripts/build-json.ts --check && bun run docs:check",
    "docs:build": "bun scripts/readme-catalog.ts",
    "docs:check": "bun scripts/readme-catalog.ts --check",
    "migrations:check": "bun scripts/migrations/domain-contract-v2.ts --check",
    "dependencies:check": "bun scripts/check-dependencies.ts",
    "security:audit": "bun audit",
    "web:build:check": "bun run --cwd apps/web build && bun scripts/check-web-bundles.ts",
    "lint": "bun run --filter '@cherrypicker/*' lint",
    "typecheck": "bun run --filter '@cherrypicker/*' typecheck",
    "verify": "bun run toolchain:check && bun run migrations:check && bun run dependencies:check && bun run security:audit && bun run data:check && npm run lint && npm run typecheck && bun run test && bun run web:build:check",
    "parse": "bun run packages/parser/src/index.ts",
    "scrape": "bun run tools/scraper/src/cli.ts",
    "analyze": "bun run tools/cli/src/index.ts analyze",
    "optimize": "bun run tools/cli/src/index.ts optimize"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "defu": "6.1.7",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.4",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "svgo": "4.0.2",
    "undici": "7.28.0",
    "vite": "8.1.5"
  },
  "packageManager": "bun@1.3.12"
}
